{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun-types"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true
  },
  // api.js is type-checked against the shared contract (see its @ts-check
  // header); more public/js files can join the program as they get typed.
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "public/js/api.js"]
}
